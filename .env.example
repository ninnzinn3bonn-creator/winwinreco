PORT=3000

# DB ドライバ: sqlite (ローカル開発) または firestore (本番)
DB_DRIVER=sqlite
DB_PATH=./db/meeting.db

# Firestore (DB_DRIVER=firestore のとき必須)
GOOGLE_CLOUD_PROJECT=
FIRESTORE_EMULATOR_HOST=

# AI
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_STT_MODEL=

# STT
STT_PROVIDER=google
STT_LANGUAGE=ja
GOOGLE_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=
ELEVENLABS_STT_REALTIME_MODEL=

# Auth / Cookie
COOKIE_SECURE=false
OWNER_EMAIL=
SIGNUP_ALLOWLIST_DISABLED=

# WebSocket
WS_ALLOWED_ORIGINS=
