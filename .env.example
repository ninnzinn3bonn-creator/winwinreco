PORT=3000

# DB ドライバ: sqlite (ローカル開発) または firestore (本番)
DB_DRIVER=sqlite
DB_PATH=./db/meeting.db

# Firestore (DB_DRIVER=firestore のとき必須)
GOOGLE_CLOUD_PROJECT=
FIRESTORE_EMULATOR_HOST=

# AI
AI_PROVIDER=groq
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_STT_MODEL=

# STT
STT_PROVIDER=elevenlabs
STT_LANGUAGE=ja
GOOGLE_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_STT_REALTIME_MODEL=scribe_v2_realtime

# Auth / Cookie
COOKIE_SECURE=false
# OWNER_EMAIL は後方互換のフォールバック (env が一致するメールは admin 権限を得る)。
# 推奨は DB ベースの is_owner フラグ — /admin/bootstrap-owner で初回ユーザーが昇格できる。
OWNER_EMAIL=

# WebSocket
WS_ALLOWED_ORIGINS=
